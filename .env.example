PORT=18003
WEB_ORIGIN=http://localhost:18004

DATABASE_URL=postgres://sgit:sgit@localhost:5437/sgit
REDIS_URL=redis://localhost:18000

S3_ENDPOINT=http://localhost:18001
S3_REGION=us-east-1
S3_BUCKET=sgit
S3_ACCESS_KEY=sgit
S3_SECRET_KEY=sgit-secreto

# Solo para el entorno local. No uses este valor en un servidor compartido.
SESION_SECRETO=sgit-local-cambia-este-valor

SEED_OPERATOR_NOMBRE=Operador de prueba
SEED_OPERATOR_CORREO=operador@sgit.local
SEED_OPERATOR_PASSWORD=operador-prueba
SEED_OPERATOR_ROL=operador

BOT_SESSION_PATH=sessions/wwebjs
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Cliente OAuth de Google. No es la contraseña del correo. Ver docs/configurar-gmail.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:18003/buzon/oauth/callback
GMAIL_CORREO=telemetria@zgroup.com.pe
INICIAR_SYNC=true
PROCESO_IMAGEN_URL=http://127.0.0.1:8000
